{
  "name": "spice-workbench",
  "version": "0.29.20",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node scripts/serve-local.mjs",
    "start:background": "powershell.exe -NoProfile -File scripts/local-service.ps1 -Action Start",
    "status:background": "powershell.exe -NoProfile -File scripts/local-service.ps1 -Action Status",
    "stop:background": "powershell.exe -NoProfile -File scripts/local-service.ps1 -Action Stop",
    "start:hapi": "node scripts/start-with-hapi.mjs",
    "dev": "vite --host 127.0.0.1 --port 3030 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 3030 --strictPort",
    "test": "npm run build && tsx --test --test-concurrency=4 tests/*.test.ts",
    "mcp:doctor": "node scripts/workbench-mcp.mjs --doctor"
  },
  "dependencies": {
    "@deepseek-ai/dsh": "0.1.5-rc.2",
    "@deepseek-ai/dsh-credentials-local": "0.1.5-rc.2",
    "@deepseek-ai/dsh-llm-deepseek": "0.1.5-rc.2",
    "@deepseek-ai/dsh-llm-pi-ai": "0.1.5-rc.2",
    "@deepseek-ai/dsh-sdk-client": "0.1.5-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.5-rc.2",
    "@earendil-works/pi-ai": "0.85.1",
    "@napi-rs/canvas": "0.1.100",
    "eecircuit-engine": "1.8.0",
    "fflate": "0.8.3",
    "katex": "0.16.47",
    "lucide-react": "1.47.0",
    "pdfjs-dist": "5.4.624",
    "playwright-core": "1.63.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "sharp": "0.35.4",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/awaqwqawa123/fuxian-spice-workbench.git"
  },
  "bugs": {
    "url": "https://github.com/awaqwqawa123/fuxian-spice-workbench/issues"
  }
}
